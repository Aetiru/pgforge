{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pgforge",
  "version": "0.2.0",
  "identifier": "dev.pgforge.app",
  "build": {
    "beforeDevCommand": "pnpm --filter pgforge-ui dev",
    "beforeBuildCommand": "pnpm --filter pgforge-ui build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pgforge",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
